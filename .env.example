# ========================================================
# BharatSign Bridge - Real Email Delivery Configuration (.env)
# ========================================================
# To receive real emails and 6-digit OTP codes in your actual Gmail inbox,
# configure ONE of the options below in a file named `.env` in the root folder.

# --------------------------------------------------------
# OPTION 1: Free Gmail SMTP (Direct to Gmail Inbox)
# --------------------------------------------------------
# 1. Go to your Google Account -> Security (https://myaccount.google.com/security)
# 2. Enable "2-Step Verification" if not already enabled.
# 3. Search for "App Passwords" (https://myaccount.google.com/apppasswords)
# 4. Generate a 16-character App Password (e.g. "abcd efgh ijkl mnop").
# 5. Enter your email and that 16-character password below (remove spaces):

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
EMAIL_FROM=your_email@gmail.com

# --------------------------------------------------------
# OPTION 2: Free Resend API (Alternative: https://resend.com)
# --------------------------------------------------------
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_123456789
# EMAIL_FROM=onboarding@resend.dev

# --------------------------------------------------------
# OPTION 3: Free Brevo (Sendinblue) API (https://brevo.com)
# --------------------------------------------------------
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-123456789
# EMAIL_FROM=your_email@gmail.com

# --------------------------------------------------------
# App Base URL (Where reset links redirect)
# --------------------------------------------------------
APP_BASE_URL=http://localhost:5173
