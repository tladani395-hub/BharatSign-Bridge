# ========================================================
# BharatSign Bridge - Configuration & Security Secrets (.env)
# ========================================================

# --------------------------------------------------------
# 1. JWT & Cryptographic Secrets
# --------------------------------------------------------
# Set a strong 64-character random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production
JWT_EXPIRE_HOURS=72

# Cryptographic salt for Human Verification Captcha tokens
CAPTCHA_SECRET=bharatsign_human_auth_verification_salt_2026

# Allowed CORS Origins (comma-separated, without trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Application Base URL (Where reset links redirect)
APP_BASE_URL=http://localhost:5173
APP_ENV=development

# --------------------------------------------------------
# 2. Email Delivery Configuration
# --------------------------------------------------------
# OPTION A: Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
EMAIL_FROM=your_email@gmail.com

# OPTION B: Resend API (Alternative)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_123456789
# EMAIL_FROM=onboarding@resend.dev

# OPTION C: Brevo API (Alternative)
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-123456789
# EMAIL_FROM=your_email@gmail.com

# --------------------------------------------------------
# 3. Google & GitHub OAuth 2.0 Authentication
# --------------------------------------------------------
# Google Cloud Console:
# 1. Create a project at https://console.cloud.google.com
# 2. APIs & Services -> Credentials -> Create Credentials -> OAuth Client ID (Web Application)
# 3. Authorized Javascript origins: http://localhost:5173
# 4. Authorized redirect URIs: http://localhost:5173/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# GitHub Developer Settings:
# 1. Go to https://github.com/settings/developers -> OAuth Apps -> New OAuth App
# 2. Application name: BharatSign Bridge
# 3. Homepage URL: http://localhost:5173
# 4. Authorization callback URL: http://localhost:5173/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VITE_GITHUB_CLIENT_ID=


